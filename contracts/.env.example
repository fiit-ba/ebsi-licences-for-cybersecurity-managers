# This file was written in 2026 by the Faculty of Informatics and Information
# Technologies for the Professional License Registry.
#
# Copy to .env. Forge reads contracts/.env by itself on every `forge script`
# and `forge test`; the npm scripts read only BESU_RPC_URL from the shell (it
# is expanded before forge starts), so export that one rather than set it here.
#
# On a development chain (the local Besu network, chain 1337, or anvil, 31337)
# everything below may stay commented out: the scripts fall back to the
# standard development accounts. On any other chain the keys are required and
# the development ones are refused. Never put a real key in a file that can be
# committed; .env itself is ignored by git.

# --- Ledger -------------------------------------------------------------------

# The local Besu network, for npm run deploy:besu, rotate:besu, supervisor:besu,
# verify:besu. Default http://127.0.0.1:8545.
# BESU_RPC_URL=http://127.0.0.1:8545

# The deployment record's name on a chain other than 1337 or 31337
# (deployments/<name>.json). Default "ledger".
# GOVERNANCE_NETWORK=ledger

# --- Governance contract: deploy (scripts/Deploy.s.sol) -------------------------

# The policies and the proposal lifetime. Default config/pilot.json.
# GOVERNANCE_CONFIG=config/production.json

# The key that pays for deployments (the governance contract and the EBSI
# mocks). Default on a development chain: the first development key.
# GOVERNANCE_DEPLOYER_KEY=0x...

# The role keys, by address; each role needs its own key. Default on a
# development chain: development accounts 1, 2 and 5 (scripts/Networks.sol).
# SIGNER_A=0x...    # the certification body's decision maker
# SIGNER_B=0x...    # its independent second approver
# SIGNER_C=0x...    # the supervisory authority (NBÚ)

# The TAO, the contract's owner. Default on a development chain: development
# account 4; elsewhere required.
# GOVERNANCE_TAO=0x...
# Its DID in the Trusted Issuers Registry. Default on a development chain: a
# placeholder; elsewhere required.
# GOVERNANCE_TAO_DID=did:ebsi:...

# Who may upgrade the implementation behind the beacon proxy: whoever holds it
# can change every rule. Default on a development chain: the deployer;
# elsewhere required (who it should be is open, TODO-v3.md O1).
# GOVERNANCE_BEACON_OWNER=0x...

# --- Governance contract: after deployment --------------------------------------

# AddTi.s.sol sets up a TI, one contract for all of them. The TAO's key.
# Default on a development chain: development key 4.
# GOVERNANCE_TAO_KEY=0x...
# TI_DID=did:ebsi:...
# TI_ATTRIBUTE_ID=0x...     # its accreditation in the Trusted Issuers Registry
# COSIGNER_DID=did:ebsi:... # signs from outside the TI (NBÚ); takes role C

# The deployed contract, for the rotation and supervisor scripts (GOVERNANCE
# wins over PLR_GOVERNANCE_CONTRACT). VerifyOnchain reads deployments/ when
# unset.
# GOVERNANCE=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# RotateSigners.s.sol: the keys that approve the rotation, comma-separated.
# Default on a development chain: the four genesis keys.
# GOVERNANCE_APPROVER_KEYS=0x...,0x...
# Gas given to a new role key whose balance is below MIN_BALANCE, in wei.
# MIN_BALANCE=500000000000000000
# TOP_UP=10000000000000000000

# SupervisorAdmin.s.sol: the key of role C. Default on a development chain:
# whichever development key holds role C.
# SUPERVISOR_KEY=0x...

# Per command, not here: TARGET (rotation), ACTION / KIND / THRESHOLD / REQUIRED /
# VETO / TIMELOCK / SUBJECT / REPLACEMENT / ROLE / TTL / SIGN / EXECUTE / CANCEL
# (supervisor). See contracts/README.md.

# --- EBSI mock infrastructure (scripts/DeployEBSI.s.sol) ------------------------

# Deploy the mocks (true, the default), or connect to existing contracts
# (false), which then all have to be named below.
# DEPLOY_EBSI=true

# Roles in the mocks. Default: the deployer.
# EBSI_ADMIN=0x...      # admin of the Policies Registry and the factory contracts
# EBSI_OPERATOR=0x...   # the Policies Registry's operator
# EBSI_GOVERNOR=0x...   # the factory contracts' EBSI governor

# Existing contracts, required when DEPLOY_EBSI=false (the addresses are in
# deployments/<network>-ebsi.json after a deployment).
# EBSI_POLICY_REGISTRY=0x...
# EBSI_DID_REGISTRY=0x...
# EBSI_PROXY_REGISTRY=0x...
# EBSI_PROXY_FACTORY=0x...
# EBSI_ISSUERS_REGISTRY=0x...
# EBSI_SCHEMAS_REGISTRY=0x...
# EBSI_TIMESTAMP=0x...

# The entity registry's DID, if one is used. Default empty.
# EBSI_DID_ENTITY_REGISTRY=did:ebsi:...

# --- Verification (Makefile: VERIFY=1 on deploy-*, or make verify-<network>) ----

# forge's --verifier: sourcify (default, no key, but its public instance
# only knows the chains it is configured for - a private network's chain id
# is not one of them), blockscout, etherscan, oklink, or custom. For your
# own Blockscout instance:
#   VERIFIER=blockscout
#   VERIFIER_URL=https://<host>/api        # Blockscout's Etherscan-compatible API
# VERIFIER_API_KEY only if that instance requires one (most do not).
# VERIFIER=sourcify
# VERIFIER_URL=
# VERIFIER_API_KEY=

# --- Tests ----------------------------------------------------------------------

# The Node 24 that runs the back-office's TypeScript for the commitment
# interoperability test. Default: node.
# PLR_NODE=node
