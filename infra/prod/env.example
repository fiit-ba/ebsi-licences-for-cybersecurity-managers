# Hosted configuration template. No deployment is performed by repository setup.
PLR_PUBLIC_HOSTNAME=registry.example.sk
PLR_CONSOLE_HOSTNAME=console.example.sk
PLR_STAFF_CIDR=10.20.0.0/16
PLR_TLS_DIR=./prod/tls
# ca.crt and backend/edge/public .crt + .key for the API mesh and edge.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Persistent authentication secret and a separate symmetric KMS wrapping-key identifier.
BACK_OFFICE_TOKEN_SECRET=
PLR_FIELD_KMS_KEY_ID=
PLR_ISSUER_DID=
# EBSI's Core API v1 origin: authorisation (/v1/auth), the registries and the Ledger API.
PLR_EBSI_API_ORIGIN=https://api-pilot.ebsi.eu
PLR_TRUSTED_ROOT_DIDS=
PLR_LEDGER_STATUS_ENTRY_SCHEMA_URL=
# The certificate registry and its governance, as deployed by contracts/ for the TAO.
PLR_GOVERNANCE_CONTRACT=
PLR_CERTIFICATE_REGISTRY=
PLR_LEDGER_CHAIN_ID=
# The Ledger API, e.g. https://api-pilot.ebsi.eu/v1/ledger: every transaction carries a token.
PLR_LEDGER_RPC_URL=
PLR_LEDGER_WALLET_RPC=
AWS_REGION=eu-central-1
# Prefer an instance/task role. Signing keys use the existing purpose-bound CLI.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional delivery handlers; configure each provider before enabling it.
BACK_OFFICE_PASSWORD_RECOVERY_ENABLED=false
# BACK_OFFICE_PASSWORD_RECOVERY_KEY=  (32 bytes canonical base64)
# POSTMARK_API_KEY=
# DEFAULT_FROM_EMAIL=
BACK_OFFICE_TIMESTAMP_ENABLED=false
# BACK_OFFICE_TIMESTAMP_KMS_KEY_ID=
# BACK_OFFICE_TIMESTAMP_RPC_URL=
# BACK_OFFICE_TIMESTAMP_CHAIN_ID=
# BACK_OFFICE_TIMESTAMP_CONTRACT=
# PLR_TIMESTAMP_TOKEN_DIR=./prod/timestamp  (contains private access-token file)
# BACK_OFFICE_TIMESTAMP_MAX_GAS_PRICE_WEI=0

# Background worker concurrency and reconciliation intervals.
PLR_WORKER_CONCURRENCY=2
PLR_GOVERNANCE_RECONCILE_SECONDS=120
PLR_STANDING_SWEEP_SECONDS=60
