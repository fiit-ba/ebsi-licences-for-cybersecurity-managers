# The back-office's mTLS sidecar (component 1).
#
# Runs in the back-office container's network namespace, where the app listens
# on 127.0.0.1:8088 only. Inbound, it is the one way in: mutual TLS from the
# edge, nothing else.
# All registry, KMS and ledger operations belong to the combined runtime.

map $ssl_client_s_dn $plr_peer {
    ~(^|,)CN=plr-edge(,|$)     edge;
    default                    "";
}

# Obsolete internal signature hops are not exposed by the combined runtime.
# Also refused at the edge; this is the second line.
map $uri $plr_retired_internal {
    ~^/registry/sign-          1;
    ~^/registry/offers/token/  1;
    default                    0;
}

server {
    listen 8443 ssl;
    http2 on;

    ssl_certificate        /tls/backend.crt;
    ssl_certificate_key    /tls/backend.key;
    ssl_client_certificate /tls/ca.crt;
    ssl_verify_client      on;
    ssl_protocols          TLSv1.3;
    client_max_body_size   10m;

    if ($plr_peer = "") { return 403; }
    set $plr_route "$plr_peer:$plr_retired_internal";
    if ($plr_route = "edge:1") { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }

    # Holder wallets' backups, as at the edge (edge.conf.template).
    location /wallet-backups/ {
        client_max_body_size 129m;
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
}
