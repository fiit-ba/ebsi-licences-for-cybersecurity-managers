# Ordinary LOCAL development. Hosted configuration uses prod/env.example.
# Start the Besu network, deploy the contracts (contracts/: make deploy-besu), then set
# these from contracts/deployments/besu.json; mvp-scripts/start-mvp.sh does all of it.
PLR_GOVERNANCE_CONTRACT=
PLR_CERTIFICATE_REGISTRY=
# Shared DNS/LAN host reachable by API containers, browser and Wallet; no scheme.
PLR_PUBLIC_HOST=

# Initial passwords for alice / bob / supervisor / mirri. Never reset on rerun.
PLR_DEV_PASSWORD=Atest-2026!Demo
# Explicit development defaults; no manual secret-generation step is required.
POSTGRES_PASSWORD=atest-development
BACK_OFFICE_TOKEN_SECRET=development-only-atest-token-secret-2026
# The local KMS data keys are generated automatically by bootstrap.
# PLR_FIELD_KMS_KEY_ID=  (optional existing symmetric wrapping key)

# Default external API port remains 8000. Frontend dev stays on 5173.
PLR_API_PORT=8000
PLR_REGISTRY_PORT=8090
PLR_BIND_ADDRESS=127.0.0.1
# For a LAN/DNS public host, bind 0.0.0.0 (or that LAN IP) so containers/phones
# can reach the configured origin; loopback binding alone cannot expose a LAN IP.
PLR_LEDGER_CHAIN_ID=1337
# The node itself, for the development EBSI service; the back-office goes through its
# Ledger API (http://ebsi-mock:8090/v1/ledger).
PLR_BESU_RPC_URL=http://host.docker.internal:8545
PLR_LEDGER_WALLET_RPC=
# The TAO the contracts are deployed for (contracts: GOVERNANCE_TAO_DID) and the
# supervisory authority (role C); the development EBSI service registers the latter.
PLR_GOVERNANCE_TAO_DID=did:ebsi:zmQaJTYt1ftvnjrwxWpPDUX
PLR_SUPERVISOR_DID=did:ebsi:zrFwbt4GwApPbWm9racT3x9
PLR_ISSUER_DID=did:ebsi:zvHWX359A3CvfJnCYaAiAde
PLR_TRUSTED_ROOT_DIDS=did:ebsi:zSupport

# Background worker concurrency and reconciliation intervals.
PLR_WORKER_CONCURRENCY=2
PLR_GOVERNANCE_RECONCILE_SECONDS=120
PLR_STANDING_SWEEP_SECONDS=60
