{
  "name": "atest-back-office",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "start": "node server/http/start.ts",
    "migrate": "node data/migrate.ts",
    "test": "node scripts/test-server.ts",
    "typecheck": "tsc && tsc -p tsconfig.tests.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.tests.json",
    "build:web": "node scripts/build-web.ts",
    "test:web": "playwright test -c web/playwright.config.ts",
    "test:identity:web": "playwright test -c web/playwright.identity.config.ts",
    "test:organizations:web": "playwright test -c web/playwright.organizations.config.ts",
    "test:issuance:web": "playwright test -c web/playwright.issuance.config.ts",
    "test:verification:web": "playwright test -c web/playwright.verification.config.ts",
    "relying-party": "node scripts/relying-party.ts",
    "sync:registry:development": "node scripts/sync-development-registry.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "check:docs": "node scripts/check-docs.ts",
    "bootstrap:admin": "node scripts/bootstrap-admin.ts",
    "keys": "node scripts/signing-keys.ts",
    "keys:fields": "node scripts/field-keys.ts",
    "test:lifecycle:web": "playwright test -c web/playwright.lifecycle.config.ts",
    "bootstrap:registry:development": "node scripts/bootstrap-registry.ts",
    "check:installation": "node checks/installation.ts",
    "test:installation:web": "playwright test -c web/playwright.installation.config.ts",
    "check:standalone": "node checks/standalone.ts",
    "test:installation": "node --test checks/installation-http.test.ts && node scripts/check-installation-stack.ts",
    "bootstrap:development": "node scripts/bootstrap-development.ts",
    "worker": "node server/worker/start.ts",
    "health:worker": "node server/worker/health.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1161.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.79.1",
    "ethers": "6.17.0",
    "jose": "6.2.10",
    "jsonpath": "1.1.1",
    "jsqr": "1.4.0",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "redis": "5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsonpath": "0.2.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "axios": "1.4.0",
    "bs58": "5.0.0",
    "elliptic": "6.6.1",
    "esbuild": "0.28.2",
    "ethereumjs-util": "7.1.5",
    "ethereumjs-wallet": "1.0.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "wallet-ethers": "npm:ethers@5.7.2"
  }
}
