NODE_IP=***********

LAC_NETWORK=***********
LAC_REGISTRY=***********
LAC_RPC_URL=***********
LAC_NODE_ADDRESS=***********
LAC_MAILBOX_DID=***********
LAC_MAILBOX_URL=********

# Back Office origin for verification and organization issuance, for example
# https://registry.example.sk.
BACKOFFICE_URL=***********
# Device-reachable EBSI origin; its Core API v1 serves DID, issuer and schema
# reads and the Ledger API under /v1. The certificate registry keeps every
# certificate's record; LEDGER_CHAIN_ID is its chain.
EBSI_URL=***********
CERTIFICATE_REGISTRY=***********
# Each TAO has its own certificate registry: the wallet recognises one by EBSI's
# Proxy Factory and the templates it was deployed from, and checks it is the
# registry of the TAO that accredited the certificate's TI. CERTIFICATE_REGISTRY
# is the one registry trusted when no factory is configured.
EBSI_PROXY_FACTORY=
CONTRACT_TEMPLATES=CertificateRegistry@1,CertificateGovernance@1
LEDGER_CHAIN_ID=***********
EBSI_SUPPORT_OFFICE_DID=***********

# Development: BACKOFFICE_URL=http://<PLR_PUBLIC_HOST>:8000 and
# EBSI_URL=http://<PLR_PUBLIC_HOST>:8090 must match infra/.env and minted URLs.
# EBSI_API=pilot (the default) reads EBSI's APIs in the shape of its pilot network
# (/did-registry/v5, /trusted-issuers-registry/v5, /trusted-schemas-registry/v3,
# /ledger/v4/blockchains/besu); EBSI_API=core-v1 reads them under /v1.
# Android's 10.0.2.2 reaches the host only from an emulator; it is unsuitable
# as the shared issuer origin. Use a LAN/DNS name reachable by every consumer.
# Rebuild the JS bundle after changing these build-time settings.
