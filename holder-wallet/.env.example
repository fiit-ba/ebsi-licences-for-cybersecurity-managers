NODE_IP=***********

LAC_NETWORK=***********
LAC_REGISTRY=***********
LAC_RPC_URL=***********
LAC_NODE_ADDRESS=***********
LAC_MAILBOX_DID=***********
LAC_MAILBOX_URL=********

# Back Office origin for verification and organization issuance, for example
# https://registry.example.sk.
BACKOFFICE_URL=***********
# Device-reachable EBSI origin; its Core API v1 serves DID, issuer and schema
# reads and the Ledger API under /v1. The certificate registry keeps every
# certificate's record; LEDGER_CHAIN_ID is its chain.
EBSI_URL=***********
CERTIFICATE_REGISTRY=***********
LEDGER_CHAIN_ID=***********
EBSI_SUPPORT_OFFICE_DID=***********

# Development: BACKOFFICE_URL=http://<PLR_PUBLIC_HOST>:8000 and
# EBSI_URL=http://<PLR_PUBLIC_HOST>:8090 must match infra/.env and minted URLs.
# Android's 10.0.2.2 reaches the host only from an emulator; it is unsuitable
# as the shared issuer origin. Use a LAN/DNS name reachable by every consumer.
# Rebuild the JS bundle after changing these build-time settings.
