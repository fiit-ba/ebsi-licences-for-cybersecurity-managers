{
  "name": "atest-wallet",
  "version": "0.3.3",
  "description": "Atest mobile wallet for professional licences",
  "author": "Faculty of Informatics and Information Technologies",
  "license": "MIT",
  "private": true,
  "resolutions": {
    "@types/react": "19.2.18",
    "@craftzdog/react-native-buffer": "6.1.2",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.7"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.js src scripts",
    "format": "prettier --write App.tsx src scripts \"*.{js,mjs,json}\"",
    "format:check": "prettier --check App.tsx src scripts \"*.{js,mjs,json}\"",
    "architecture:check": "node scripts/check-architecture.mjs",
    "license:check": "node scripts/check-license.mjs",
    "test": "jest",
    "test:ci": "jest --runInBand --watchAll=false",
    "doctor": "npx expo-doctor",
    "check:dependencies": "expo install --check",
    "verify": "yarn typecheck && yarn lint && yarn format:check && yarn architecture:check && yarn license:check && yarn test:ci",
    "postinstall": "patch-package",
    "build:ios": "expo export:embed --reset-cache --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "build:android": "expo export:embed --reset-cache --entry-file index.js --platform android --dev false --bundle-output android/app/build/generated/assets/createBundleReleaseJsAndAssets/index.android.bundle --assets-dest android/app/build/generated/res/createBundleReleaseJsAndAssets",
    "build:android:apk": "cd android && ./gradlew assembleRelease",
    "build:android:aab": "cd android && ./gradlew bundleRelease",
    "build:android:production": "cd android && ./gradlew bundleRelease -PplrProduction=true"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./scripts/jest/setup.js"
    ],
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@babel/runtime/helpers/(.*)$": "<rootDir>/node_modules/@babel/runtime/helpers/$1.js",
      "^jose$": "<rootDir>/node_modules/jose/dist/node/cjs/index.js",
      "^jose/dist/browser/index.js$": "<rootDir>/node_modules/jose/dist/node/cjs/index.js"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@cef-ebsi/key-did-resolver": "1.1.0",
    "@cef-ebsi/wallet-lib": "^4.2.0",
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@dreson4/react-native-quick-bip39": "^0.0.5",
    "@ethersproject/shims": "^5.7.0",
    "@expo/vector-icons": "^15.0.3",
    "@lacchain/did": "^1.6.3",
    "@lacchain/gas-model-provider": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.11.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/material-top-tabs": "^7.8.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tradle/react-native-http": "^2.0.1",
    "@types/text-encoding": "^0.0.36",
    "assert": "^1.5.0",
    "axios": "^1.3.4",
    "bs58": "^5.0.0",
    "buffer": "^4.9.2",
    "dayjs": "^1.11.18",
    "did-resolver": "^4.1.0",
    "dns.js": "^1.0.1",
    "eccrypto-js": "^5.4.0",
    "ed2curve": "^0.3.0",
    "elliptic": "^6.5.4",
    "ethereumjs-util": "^7.1.5",
    "ethereumjs-wallet": "^1.0.2",
    "ethers": "5.7.0",
    "events": "^1.1.1",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^22.4.10",
    "jose": "^4.14.4",
    "jsonpath": "^1.1.1",
    "jsonschema": "^1.4.1",
    "jsontokens": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "pako": "^2.1.0",
    "punycode": "^1.4.1",
    "qrcode-generator": "2.0.4",
    "qs": "^6.11.2",
    "querystring-es3": "^0.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^12.2.0",
    "react-native": "0.86.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-nitro-modules": "0.33.2",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^5.15.3",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.3.1",
    "react-native-tab-view": "^3.5.2",
    "react-native-tcp-socket": "6.4.3",
    "react-native-web": "^0.21.0",
    "readable-stream": "^1.0.33",
    "stream-browserify": "^1.0.0",
    "string_decoder": "^0.10.31",
    "styled-components": "^6.5.3",
    "text-encoding": "^0.7.0",
    "typechain-types": "^0.0.1",
    "url": "^0.10.3",
    "util": "^0.10.4",
    "uuid": "^9.0.0",
    "web3": "^1.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/emscripten": "^1.41.5",
    "@types/jest": "29.5.14",
    "@types/jsonpath": "^0.2.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pako": "^2.0.3",
    "@types/react": "~19.2.10",
    "@types/react-native-html-to-pdf": "^0.8.1",
    "@types/uuid": "^9.0.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.3.1",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-libsodium",
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
